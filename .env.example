# Copy to .env and fill in values for local development
# Never commit .env

APP_ENV=development

# Services
INGESTION_PORT=8080
ANALYTICS_PORT=8081

# MongoDB — use MongoDB Atlas free tier for cloud dev
MONGO_URI=mongodb://root:password@localhost:27017
MONGO_DATABASE=marketpulse

# Kafka — use Upstash Kafka free tier for cloud dev
KAFKA_BROKERS=localhost:9092
KAFKA_EVENT_TOPIC=ecommerce.events
KAFKA_CONSUMER_GROUP=marketpulse-processor

# Redis — use Upstash Redis free tier for cloud dev
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=300

METRICS_ENABLED=true
